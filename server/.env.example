# ================================
# 合伙造 - 后端环境配置模板
# ================================

# 应用环境
# development - 开发环境 (邮件验证码打印到控制台)
# production  - 生产环境 (使用SMTP发送真实邮件)
NODE_ENV=development
PORT=3000

# ================================
# 数据库配置 (PostgreSQL)
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=hehuozao

# ================================
# JWT 认证配置
# ================================
# 生产环境请使用强密钥！
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ================================
# 邮件配置 (仅生产环境需要)
# ================================
# 支持的邮件服务商示例:
# - QQ邮箱: smtp.qq.com:465
# - 163邮箱: smtp.163.com:465
# - Gmail: smtp.gmail.com:587
# - 阿里企业邮箱: smtp.mxhichina.com:465

MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=your_email@qq.com
MAIL_PASS=your_smtp_authorization_code
MAIL_FROM="合伙造 <your_email@qq.com>"

# ================================
# 验证码配置
# ================================
# 验证码有效期（分钟）
VERIFICATION_CODE_EXPIRES=10
