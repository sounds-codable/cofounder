NODE_ENV=development
PORT=3010

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=cofounder_new
DB_LOGGING=false
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true
# 仅在本地演示时手动开启；生产部署务必保持 false
SEED_DEMO_DATA_ENABLED=false

JWT_SECRET=replace_with_a_real_secret
JWT_EXPIRES_IN=30d
# 登录保持30天
AUTH_ACCESS_TOKEN_TTL_DAYS=30
# 注册是否需要邀请码
AUTH_REQUIRE_INVITE_FOR_SIGNUP=true

AUTH_SEND_CODE_INTERVAL_SECONDS=20
AUTH_SEND_CODE_MAX_PER_EMAIL_PER_HOUR=15
AUTH_SEND_CODE_MAX_PER_IP_PER_HOUR=60
AUTH_VERIFY_MAX_FAILURES=6
AUTH_VERIFY_LOCK_MINUTES=30

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://cofounder.icu,https://www.cofounder.icu
TRUST_PROXY=true
REQUEST_BODY_LIMIT_KB=256

MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_REQUIRE_TLS=false
MAIL_USER=hello@example.com
MAIL_PASS=replace_with_mail_password
MAIL_FROM="叩饭（Cofounder） <hello@example.com>"
# 兼容别名（可二选一）：
# MAIL_USERNAME=hello@example.com
# MAIL_PASSWORD=replace_with_mail_password
# MAIL_FROM_ADDRESS=hello@example.com
# MAIL_FROM_NAME="叩饭（Cofounder）"
# MAIL_ENCRYPTION=ssl

LOGO_VARIANT=overlap

# 为了合规要求 留存信息
AUDIT_LOG_RETENTION_DAYS=180
PUBLISHED_RECORD_RETENTION_DAYS=365
COMPLIANCE_CLEANUP_INTERVAL_MINUTES=360
