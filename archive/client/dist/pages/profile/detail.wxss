.edit-detail{background:#f8fafc;box-sizing:border-box;min-height:100vh;overflow-y:auto;padding:20rpx 20rpx 160rpx}.form{background:#fff;border-radius:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05);padding:40rpx}.form-title{color:#1e293b;display:block;font-size:36rpx;font-weight:700;margin-bottom:12rpx}.form-subtitle{color:#64748b;display:block;font-size:26rpx;margin-bottom:40rpx}.form-section-title{border-top:2rpx solid #f1f5f9;color:#1e293b;font-size:30rpx;font-weight:700;margin:40rpx 0 24rpx;padding-top:24rpx}.form-item{margin-bottom:32rpx}.form-label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:16rpx}.form-input{background:#f1f5f9;border-radius:16rpx;box-sizing:border-box;color:#1e293b;font-size:28rpx;height:88rpx;padding:0 24rpx;width:100%}.form-textarea{background:#f1f5f9;border-radius:16rpx;box-sizing:border-box;color:#1e293b;font-size:28rpx;height:200rpx;padding:20rpx 24rpx;width:100%}.form-textarea-large{height:300rpx}.form-counter{color:#94a3b8;display:block;font-size:22rpx;margin-top:8rpx;text-align:right}.form-picker{background:#f1f5f9;border-radius:16rpx;color:#64748b;font-size:28rpx;height:88rpx;line-height:88rpx;padding:0 24rpx}.tag-group{display:flex;flex-wrap:wrap;gap:16rpx}.tag{background:#f1f5f9;border:2rpx solid transparent;border-radius:32rpx;color:#64748b;font-size:26rpx;padding:16rpx 24rpx}.tag.active{background:#eff6ff;border-color:#2563eb;color:#2563eb}.action-bar{background:#fff;bottom:0;box-shadow:0 -4rpx 20rpx rgba(0,0,0,.08);box-sizing:border-box;left:0;margin:0 auto;max-width:960rpx;padding:24rpx 40rpx;position:fixed;right:0}.btn-save{background:linear-gradient(135deg,#2563eb,#1d4ed8);border:none;border-radius:44rpx;color:#fff;font-size:32rpx;font-weight:600;height:88rpx;width:100%}