.profile{background:#f8fafc;min-height:100vh;overflow-y:auto}.loading{align-items:center;color:#64748b;display:flex;font-size:32rpx;height:100vh;justify-content:center}.tabs{background:#fff;border-bottom:2rpx solid #e2e8f0;display:flex;padding:0 20rpx;position:sticky;top:0;z-index:100}.tab{color:#64748b;flex:1;font-size:26rpx;height:88rpx;line-height:88rpx;position:relative;text-align:center}.tab.active{color:#2563eb;font-weight:600}.tab.active::after{background:#2563eb;border-radius:2rpx;bottom:0;content:"";height:4rpx;left:50%;position:absolute;transform:translateX(-50%);width:48rpx}.profile-header{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;padding:72rpx 40rpx;text-align:center}.profile-avatar{display:block;font-size:112rpx;margin-bottom:20rpx}.profile-name{display:block;font-size:40rpx;font-weight:700;margin-bottom:12rpx}.profile-role{background:hsla(0,0%,100%,.2);border-radius:24rpx;display:inline-block;font-size:28rpx;opacity:.9;padding:8rpx 24rpx}.profile-section{background:#fff;margin-top:20rpx;padding:0 40rpx}.section-header{align-items:center;border-bottom:2rpx solid #f1f5f9;display:flex;justify-content:space-between;padding:28rpx 0}.section-title{color:#1e293b;font-size:30rpx;font-weight:600}.section-action{color:#2563eb;font-size:28rpx}.info-item{align-items:center;border-bottom:2rpx solid #f1f5f9;display:flex;justify-content:space-between;padding:24rpx 0}.info-item:last-child{border-bottom:none}.info-label{color:#64748b;font-size:28rpx}.info-value{color:#1e293b;flex:1;font-size:28rpx;margin-left:20rpx;text-align:right}.info-value.complete{color:#10b981}.info-value.incomplete{color:#f59e0b}.profile-actions{padding:72rpx 40rpx}.btn-logout{background:#fff;border:2rpx solid #ef4444;border-radius:44rpx;color:#ef4444;font-size:30rpx;height:88rpx;width:100%}