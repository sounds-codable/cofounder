.index{background:linear-gradient(180deg,#2563eb,#1d4ed8);min-height:100vh;overflow-y:auto}.loading{align-items:center;background:#f8fafc;color:#64748b;display:flex;font-size:32rpx;height:100vh;justify-content:center}.hero{color:#fff;padding:96rpx 40rpx 72rpx;text-align:center}.hero-emoji{font-size:96rpx;margin-bottom:24rpx}.hero-title{display:block;font-size:44rpx;font-weight:700;line-height:1.4;margin-bottom:32rpx}.hero-slogan{margin-bottom:56rpx}.hero-actions{display:flex;flex-direction:column;gap:24rpx;padding:0 20rpx}.slogan-item{display:block;font-size:28rpx;margin-bottom:8rpx;opacity:.9}.btn-role{border:none;border-radius:48rpx;font-size:32rpx;font-weight:600;height:96rpx;line-height:96rpx;width:100%}.btn-role.btn-owner{background:#fff;color:#2563eb}.btn-role.btn-dev{background:hsla(0,0%,100%,.2);border:2rpx solid hsla(0,0%,100%,.5);color:#fff}.section{background:#f8fafc;padding:40rpx}.section-title{color:#1e293b;display:block;font-size:36rpx;font-weight:700;margin-bottom:32rpx}.how-it-works{background:#fff}.steps{align-items:center;display:flex;justify-content:space-between}.step{align-items:center;display:flex;flex:1;flex-direction:column}.step-num{background:#2563eb;border-radius:50%;color:#fff;font-size:28rpx;font-weight:700;height:56rpx;line-height:56rpx;margin-bottom:12rpx;text-align:center;width:56rpx}.step-title{color:#1e293b;font-size:26rpx;font-weight:600;margin-bottom:4rpx}.step-desc{color:#64748b;font-size:22rpx}.step-arrow{color:#cbd5e1;font-size:32rpx}.preview-card{background:#fff;border-radius:20rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);margin-bottom:20rpx;padding:28rpx}.preview-card .preview-title{color:#1e293b;display:block;font-size:32rpx;font-weight:600;margin-bottom:12rpx}.preview-card .preview-info{align-items:center;display:flex;gap:16rpx;margin-bottom:12rpx}.preview-card .preview-tag{background:#f1f5f9;border-radius:8rpx;color:#64748b;font-size:24rpx;padding:6rpx 12rpx}.preview-card .preview-time{color:#94a3b8;font-size:24rpx}.preview-card .preview-desc{color:#64748b;font-size:26rpx;line-height:1.5}.btn-more{background:transparent;border:2rpx dashed #e2e8f0;border-radius:16rpx;color:#2563eb;font-size:28rpx;font-weight:500;height:80rpx;margin-top:16rpx;width:100%}.footer{background:#f8fafc;padding:40rpx;text-align:center}.footer-text{color:#94a3b8;font-size:24rpx}