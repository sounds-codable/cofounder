.requests{background:#f8fafc;min-height:100vh;overflow-y:auto}.segment-wrapper{background:#fff;display:flex;gap:20rpx;margin-top:20rpx;padding:24rpx 28rpx}.segment-item{background:#f1f5f9;border-radius:36rpx;color:#64748b;flex:1;font-size:28rpx;font-weight:500;height:72rpx;line-height:72rpx;text-align:center}.segment-item.active{background:#2563eb;color:#fff;font-weight:600}.tabs{background:#fff;border-bottom:2rpx solid #e2e8f0;display:flex;padding:0 20rpx;position:sticky;top:0;z-index:100}.tab{color:#64748b;flex:1;font-size:26rpx;height:88rpx;line-height:88rpx;position:relative;text-align:center}.tab.active{color:#2563eb;font-weight:600}.tab.active::after{background:#2563eb;border-radius:2rpx;bottom:0;content:"";height:4rpx;left:50%;position:absolute;transform:translateX(-50%);width:48rpx}.sub-tabs{background:#fff;display:flex;gap:20rpx;padding:20rpx 40rpx}.sub-tab{background:#f1f5f9;border-radius:36rpx;color:#64748b;flex:1;font-size:28rpx;height:72rpx;line-height:72rpx;text-align:center}.sub-tab.active{background:#2563eb;color:#fff}.empty,.loading{align-items:center;color:#64748b;display:flex;flex-direction:column;justify-content:center;padding:120rpx 40rpx}.empty-emoji{font-size:96rpx;margin-bottom:24rpx}.empty-text{font-size:32rpx}.request-list{padding:20rpx 20rpx 32rpx}.request-card{background:#fff;border-radius:20rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);margin-bottom:20rpx;padding:32rpx}.request-header{align-items:center;display:flex;margin-bottom:20rpx}.request-avatar{font-size:56rpx;margin-right:16rpx}.request-info{flex:1}.request-name{color:#1e293b;display:block;font-size:30rpx;font-weight:600;margin-bottom:4rpx}.request-time{color:#94a3b8;font-size:24rpx}.request-status{border-radius:16rpx;font-size:24rpx;padding:8rpx 16rpx}.request-status.status-pending{background:#fef3c7;color:#f59e0b}.request-status.status-accepted{background:#d1fae5;color:#10b981}.request-status.status-rejected{background:#fee2e2;color:#ef4444}.request-message{color:#64748b;font-size:28rpx;line-height:1.5;margin-bottom:20rpx}.request-actions{display:flex;gap:20rpx}.btn-accept{background:#2563eb;border:none;border-radius:40rpx;color:#fff;flex:1;font-size:28rpx;height:76rpx;line-height:76rpx}.btn-reject{background:#f1f5f9;border:none;border-radius:40rpx;color:#64748b;flex:1;font-size:28rpx;height:76rpx;line-height:76rpx}.contact-info{background:#f0fdf4;border-radius:16rpx;margin-top:16rpx;padding:20rpx}.contact-label{color:#64748b;font-size:26rpx}.contact-value{color:#1e293b;font-size:28rpx;font-weight:600}