.page{align-items:center;background:#0a0a0a;display:flex;flex-direction:column;justify-content:center;min-height:100vh;padding:80rpx 48rpx;-webkit-font-smoothing:antialiased}.center{max-width:840rpx;text-align:center;width:100%}.logo{color:#fff;display:block;font-size:72rpx;font-weight:900;letter-spacing:8rpx;margin-bottom:40rpx}.tagline{color:#64748b;display:block;font-size:32rpx;line-height:1.6;margin-bottom:64rpx;white-space:pre-line}.status-bar{align-items:center;display:flex;justify-content:center;margin-bottom:56rpx}.status-text{color:#3b82f6;font-size:28rpx;font-weight:600;letter-spacing:2rpx}.actions{display:flex;flex-direction:column;gap:24rpx}.note{color:#64748b;display:block;font-size:24rpx;margin-top:16rpx;text-align:center}.btn-dev,.btn-owner{border:none;border-radius:20rpx;font-size:30rpx;font-weight:700;height:96rpx;line-height:96rpx;width:100%}.btn-owner{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff}.btn-dev{background:#1f2937;border:2rpx solid #374151;color:#fff}.foot{bottom:48rpx;color:#1e293b;font-size:24rpx;position:absolute}@media (min-width:640px){.logo{font-size:96rpx}.tagline{font-size:36rpx}}