.login{background:#f8fafc;box-sizing:border-box;min-height:100vh;overflow-y:auto;padding:40rpx}.login-header{padding:72rpx 0 48rpx;text-align:center}.login-emoji{display:block;font-size:96rpx;margin-bottom:24rpx}.login-title{color:#1e293b;display:block;font-size:44rpx;font-weight:700;margin-bottom:16rpx}.login-subtitle{color:#64748b;display:block;font-size:28rpx}.login-form{background:#fff;border-radius:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.05);padding:40rpx}.form-item{margin-bottom:32rpx}.form-label{color:#1e293b;display:block;font-size:28rpx;font-weight:600;margin-bottom:16rpx}.form-input{background:#f1f5f9;border:2rpx solid transparent;border-radius:16rpx;box-sizing:border-box;color:#1e293b;font-size:30rpx;height:88rpx;padding:0 24rpx;width:100%}.form-input:focus{background:#fff;border-color:#2563eb}.code-input-wrapper{display:flex;gap:16rpx}.code-input-wrapper .form-input{flex:1}.btn-resend{background:#f1f5f9;border:none;border-radius:16rpx;color:#2563eb;font-size:26rpx;height:88rpx;width:200rpx}.btn-resend[disabled]{color:#94a3b8}.form-hint{color:#64748b;display:block;font-size:24rpx;margin-top:12rpx}.btn-primary{background:linear-gradient(135deg,#2563eb,#1d4ed8);border:none;border-radius:44rpx;color:#fff;font-size:32rpx;font-weight:600;height:88rpx;width:100%}