.owner-detail{background:#f8fafc;min-height:100vh;overflow-y:auto;padding-bottom:80rpx}.error,.loading{align-items:center;color:#64748b;display:flex;font-size:32rpx;height:100vh;justify-content:center}.back-btn{margin-bottom:24rpx;text-align:left}.back-icon{color:hsla(0,0%,100%,.85);font-size:30rpx}.detail-header{background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;padding:40rpx 40rpx 72rpx;text-align:center}.owner-avatar{display:block;font-size:112rpx;margin-bottom:20rpx}.owner-name{display:block;font-size:40rpx;font-weight:700;margin-bottom:12rpx}.owner-industry{font-size:28rpx;opacity:.9}.detail-section{background:#fff;margin-top:20rpx;padding:32rpx 40rpx}.section-label{color:#64748b;display:block;font-size:28rpx;font-weight:600;margin-bottom:16rpx}.section-content{color:#1e293b;font-size:30rpx;line-height:1.7}.tag-list{display:flex;flex-wrap:wrap;gap:16rpx}.project-list{display:flex;flex-direction:column;gap:24rpx}.project-card{background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:20rpx;padding:28rpx 32rpx;transition:box-shadow .2s}.project-card:active{box-shadow:0 4rpx 16rpx rgba(0,0,0,.1)}.project-title{color:#1e293b;display:block;font-size:30rpx;font-weight:600;margin-bottom:12rpx}.project-meta{align-items:center;display:flex;gap:16rpx;margin-bottom:12rpx}.project-applicants{color:#64748b;font-size:26rpx}.project-desc{color:#64748b;display:block;font-size:28rpx;line-height:1.5}@media (min-width:768px){.owner-detail{margin:0 auto;max-width:1800rpx}.owner-name{font-size:48rpx}.section-label{font-size:32rpx}.section-content{font-size:32rpx}}