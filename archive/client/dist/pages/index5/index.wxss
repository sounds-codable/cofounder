.index5{background:radial-gradient(1800rpx 1040rpx at 10% -8%,rgba(99,102,241,.13),transparent 60%),radial-gradient(1360rpx 960rpx at 90% 4%,rgba(56,189,248,.1),transparent 65%),radial-gradient(1200rpx 800rpx at 50% 80%,rgba(168,85,247,.07),transparent 70%),linear-gradient(172deg,#fafcff,#f0f4ff 40%,#f5f0ff 72%,#fafcff);color:#0f172a;min-height:100vh}.hero{margin:0 auto;max-width:1720rpx;padding:128rpx 40rpx 56rpx;text-align:center}.eyebrow{background:linear-gradient(135deg,rgba(99,102,241,.1),rgba(56,189,248,.08));border:2rpx solid rgba(99,102,241,.14);border-radius:1998rpx;color:#4f46e5;display:inline-flex;font-size:24rpx;font-weight:700;letter-spacing:3.6rpx;padding:12rpx 32rpx}.title{color:#0f172a;display:block;font-size:76rpx;font-weight:900;letter-spacing:-1rpx;line-height:1.22;margin-top:36rpx}.subtitle{color:#475569;display:block;font-size:32rpx;line-height:1.75;margin:32rpx auto 0;max-width:1120rpx}.waitlist-box{background:hsla(0,0%,100%,.92);border:2rpx solid rgba(99,102,241,.12);border-radius:32rpx;box-shadow:0 2rpx 6rpx rgba(15,23,42,.04),0 40rpx 96rpx rgba(99,102,241,.08);margin-top:56rpx;padding:28rpx}.top-box{margin-left:auto;margin-right:auto;max-width:1040rpx}.input-row{display:flex;gap:16rpx}.email-input{background:#f8fafc;border:2rpx solid #e2e8f0;border-radius:24rpx;box-sizing:border-box;color:#0f172a;flex:1;height:100rpx;min-width:0;padding:0 32rpx;transition:border-color .2s}.submit-btn{align-items:center;background:linear-gradient(135deg,#6366f1,#8b5cf6);border-radius:24rpx;box-shadow:0 8rpx 28rpx rgba(99,102,241,.3),0 2rpx 6rpx rgba(99,102,241,.2);display:flex;flex-shrink:0;height:100rpx;justify-content:center;padding:0 44rpx;transition:transform .15s,box-shadow .15s}.submit-btn:active{transform:scale(.97)}.submit-btn.disabled{opacity:.6}.submit-btn-text{color:#fff;font-size:30rpx;font-weight:700;white-space:nowrap}.waitlist-note{color:#94a3b8;display:block;font-size:24rpx;margin-top:20rpx;text-align:center}.metric-row{display:grid;gap:24rpx;grid-template-columns:1fr;margin-top:64rpx}.metric-card{background:hsla(0,0%,100%,.82);border:2rpx solid rgba(148,163,184,.14);border-radius:36rpx;box-shadow:0 16rpx 48rpx rgba(15,23,42,.04);padding:40rpx 32rpx;text-align:center;transition:transform .2s,box-shadow .2s}.metric-card:active{box-shadow:0 28rpx 72rpx rgba(15,23,42,.07);transform:translateY(-4rpx)}.mc-1{border-top:6rpx solid #6366f1}.mc-2{border-top:6rpx solid #0ea5e9}.mc-3{border-top:6rpx solid #a855f7}.metric-icon{display:block;font-size:48rpx;margin-bottom:12rpx}.metric-value{color:#0f172a;display:block;font-size:40rpx;font-weight:900}.metric-label{color:#64748b;display:block;font-size:26rpx;line-height:1.5;margin-top:8rpx}.content{display:grid;gap:28rpx;grid-template-columns:1fr;margin:0 auto;max-width:1720rpx;padding:20rpx 40rpx}.block-card{background:hsla(0,0%,100%,.88);border:2rpx solid rgba(148,163,184,.18);border-radius:40rpx;box-shadow:0 20rpx 64rpx rgba(15,23,42,.04);overflow:hidden;padding:48rpx 40rpx;position:relative}.featured-card{background:linear-gradient(135deg,#6366f1,#8b5cf6);border-color:transparent;box-shadow:0 32rpx 80rpx rgba(99,102,241,.2)}.block-num{color:rgba(99,102,241,.12);display:block;font-size:64rpx;font-weight:900;line-height:1;margin-bottom:20rpx}.featured-card .block-num{color:hsla(0,0%,100%,.2)}.featured-card .block-desc,.featured-card .block-title{color:#fff}.block-title{color:#0f172a;display:block;font-size:40rpx;font-weight:800;line-height:1.35}.block-desc{color:#475569;display:block;font-size:28rpx;line-height:1.8;margin-top:20rpx}.featured-card .block-desc{color:hsla(0,0%,100%,.88)}.bottom-cta{margin:0 auto;max-width:1720rpx;padding:64rpx 40rpx 120rpx;text-align:center}.bottom-title{color:#0f172a;display:block;font-size:56rpx;font-weight:900;letter-spacing:-.6rpx;line-height:1.3;margin:0 auto;max-width:1200rpx}.bottom-sub{color:#64748b;display:block;font-size:30rpx;margin-top:20rpx}.bottom-box{margin-left:auto;margin-right:auto;margin-top:40rpx;max-width:1040rpx}.success-msg{color:#059669;display:block;font-size:28rpx;font-weight:700;margin-top:28rpx}.error-msg{color:#dc2626;display:block;font-size:28rpx;font-weight:700;margin-top:28rpx}.foot-note{color:#94a3b8;display:block;font-size:24rpx;margin-top:20rpx}@media (min-width:780px){.title{font-size:104rpx}.metric-row{grid-template-columns:repeat(3,1fr)}.content{grid-template-columns:repeat(3,1fr)}.bottom-title{font-size:68rpx}}