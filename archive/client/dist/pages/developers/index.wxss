.developer-list{background:#f8fafc;min-height:100vh;overflow-y:auto}.tabs{background:#fff;border-bottom:2rpx solid #e2e8f0;display:flex;padding:0 20rpx;position:sticky;top:0;z-index:100}.tab{color:#64748b;flex:1;font-size:26rpx;height:88rpx;line-height:88rpx;position:relative;text-align:center}.tab.active{color:#2563eb;font-weight:600}.tab.active::after{background:#2563eb;border-radius:2rpx;bottom:0;content:"";height:4rpx;left:50%;position:absolute;transform:translateX(-50%);width:48rpx}.empty,.loading{align-items:center;color:#64748b;display:flex;flex-direction:column;justify-content:center;padding:120rpx 40rpx}.empty-emoji{font-size:96rpx;margin-bottom:24rpx}.empty-text{font-size:32rpx}.developer-scroll{padding:20rpx}.developer-card{background:#fff;border-radius:20rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);margin-bottom:20rpx;padding:32rpx}.dev-header{align-items:center;display:flex;margin-bottom:20rpx}.dev-avatar{font-size:64rpx;margin-right:20rpx}.dev-info{flex:1}.dev-name{color:#1e293b;display:block;font-size:32rpx;font-weight:700;margin-bottom:4rpx}.dev-exp{color:#64748b;font-size:26rpx}.dev-techs{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:16rpx}.tech-tag{background:#eff6ff;border-radius:20rpx;color:#2563eb;font-size:24rpx;padding:8rpx 20rpx}.dev-bio{color:#64748b;font-size:28rpx;line-height:1.5}