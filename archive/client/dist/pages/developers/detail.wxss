.developer-detail{background:#f8fafc;min-height:100vh;overflow-y:auto;padding-bottom:160rpx}.error,.loading{align-items:center;color:#64748b;display:flex;font-size:32rpx;height:100vh;justify-content:center}.detail-header{background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;padding:72rpx 40rpx;text-align:center}.dev-avatar{display:block;font-size:112rpx;margin-bottom:20rpx}.dev-name{display:block;font-size:40rpx;font-weight:700;margin-bottom:12rpx}.dev-exp{font-size:28rpx;opacity:.9}.detail-section{background:#fff;margin-top:20rpx;padding:32rpx 40rpx}.section-label{color:#64748b;display:block;font-size:28rpx;font-weight:600;margin-bottom:16rpx}.section-content{color:#1e293b;font-size:30rpx;line-height:1.7}.tech-tags{display:flex;flex-wrap:wrap;gap:16rpx}.tech-tag{background:#eff6ff;border-radius:28rpx;color:#2563eb;font-size:26rpx;padding:12rpx 28rpx}.action-bar{background:#fff;bottom:0;box-shadow:0 -4rpx 20rpx rgba(0,0,0,.08);box-sizing:border-box;left:0;margin:0 auto;max-width:960rpx;padding:24rpx 40rpx;position:fixed;right:0}.btn-request{background:linear-gradient(135deg,#2563eb,#1d4ed8);border:none;border-radius:44rpx;color:#fff;font-size:32rpx;font-weight:600;height:88rpx;width:100%}