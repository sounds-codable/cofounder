.project-list{background:#f8fafc;min-height:100vh;overflow-y:auto;padding-bottom:120rpx}.tabs{background:#fff;border-bottom:2rpx solid #e2e8f0;display:flex;padding:0 20rpx;position:sticky;top:0;z-index:100}.tab{color:#64748b;flex:1;font-size:26rpx;height:88rpx;line-height:88rpx;position:relative;text-align:center}.tab.active{color:#2563eb;font-weight:600}.tab.active::after{background:#2563eb;border-radius:2rpx;bottom:0;content:"";height:4rpx;left:50%;position:absolute;transform:translateX(-50%);width:48rpx}.empty,.loading{align-items:center;color:#64748b;display:flex;flex-direction:column;justify-content:center;padding:120rpx 40rpx}.empty-emoji{font-size:96rpx;margin-bottom:24rpx}.empty-text{font-size:32rpx;margin-bottom:12rpx}.empty-hint{color:#94a3b8;font-size:26rpx}.project-scroll{padding:20rpx}.project-card{background:#fff;border-radius:20rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);margin-bottom:20rpx;padding:32rpx}.project-title{color:#1e293b;display:block;font-size:34rpx;font-weight:700;margin-bottom:16rpx}.project-meta{align-items:center;display:flex;gap:16rpx;margin-bottom:16rpx}.project-industry{background:#eff6ff;border-radius:8rpx;color:#2563eb;font-size:24rpx;padding:8rpx 16rpx}.project-time{color:#94a3b8;font-size:24rpx}.project-desc{color:#64748b;font-size:28rpx;line-height:1.6;margin-bottom:16rpx}.project-skills{display:flex;flex-wrap:wrap;gap:12rpx}.skill-tag{background:#f1f5f9;border-radius:16rpx;color:#64748b;font-size:22rpx;padding:8rpx 16rpx}.fab{align-items:center;background:linear-gradient(135deg,#2563eb,#1d4ed8);border-radius:56rpx;bottom:140rpx;box-shadow:0 8rpx 24rpx rgba(37,99,235,.4);display:flex;height:112rpx;justify-content:center;position:fixed;right:40rpx;width:112rpx}.fab-icon{color:#fff;font-size:56rpx;line-height:1}