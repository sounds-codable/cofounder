.project-detail{background:#f8fafc;min-height:100vh;overflow-y:auto;padding-bottom:160rpx}.error,.loading{align-items:center;color:#64748b;display:flex;font-size:32rpx;height:100vh;justify-content:center}.detail-header{background:#fff;margin-bottom:20rpx;padding:40rpx}.detail-title{color:#1e293b;display:block;font-size:40rpx;font-weight:700;margin-bottom:20rpx}.detail-meta{align-items:center;display:flex;gap:16rpx}.detail-industry{background:#eff6ff;border-radius:12rpx;color:#2563eb;font-size:26rpx;padding:8rpx 20rpx}.detail-time{color:#94a3b8;font-size:26rpx}.detail-section{background:#fff;margin-bottom:20rpx;padding:32rpx 40rpx}.section-label{color:#64748b;display:block;font-size:28rpx;font-weight:600;margin-bottom:16rpx}.section-content{color:#1e293b;font-size:30rpx;line-height:1.7;white-space:pre-wrap}.skill-tags{display:flex;flex-wrap:wrap;gap:16rpx}.skill-tag{background:#eff6ff;border-radius:24rpx;color:#2563eb;font-size:26rpx;padding:12rpx 24rpx}.owner-info .owner-card{background:#f8fafc;border-radius:16rpx;padding:24rpx}.owner-name{color:#1e293b;display:block;font-size:30rpx;font-weight:600;margin-bottom:8rpx}.owner-bio{color:#64748b;font-size:26rpx}.owner-card.clickable{transition:box-shadow .2s}.owner-card.clickable:active{box-shadow:0 4rpx 16rpx rgba(0,0,0,.1)}.owner-link{color:#2563eb;display:block;font-size:26rpx;margin-top:12rpx}.action-bar{background:#fff;bottom:0;box-shadow:0 -4rpx 20rpx rgba(0,0,0,.08);box-sizing:border-box;left:0;margin:0 auto;max-width:960rpx;padding:24rpx 40rpx;position:fixed;right:0}.btn-request{background:linear-gradient(135deg,#2563eb,#1d4ed8);border:none;border-radius:44rpx;color:#fff;font-size:32rpx;font-weight:600;height:88rpx;width:100%}