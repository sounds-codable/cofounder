.index1{align-items:center;background:radial-gradient(2400rpx 1200rpx at 50% -20%,rgba(239,68,68,.14),transparent 60%),#0b0f17;display:flex;justify-content:center;min-height:100vh;padding:48rpx}.card{background:rgba(15,23,42,.86);border:2rpx solid rgba(148,163,184,.2);border-radius:36rpx;box-shadow:0 40rpx 100rpx rgba(0,0,0,.35);max-width:1040rpx;padding:64rpx 48rpx;text-align:center;width:100%}.title{color:#f43f5e;display:block;font-size:112rpx;font-weight:900;letter-spacing:16rpx;line-height:1}.subtitle{color:#f1f5f9;display:block;font-size:36rpx;font-weight:700;margin-top:16rpx}.desc{color:#cbd5e1;display:block;font-size:30rpx;line-height:1.7;margin-top:36rpx;white-space:pre-line}.form{margin-top:44rpx}.input{background:#0f172a;border:2rpx solid #334155;border-radius:20rpx;box-sizing:border-box;color:#f8fafc;height:96rpx;padding:0 28rpx;width:100%}.button{align-items:center;background:linear-gradient(135deg,#ef4444,#fb7185);border-radius:20rpx;display:flex;height:96rpx;justify-content:center;margin-top:20rpx}.button.disabled{opacity:.6}.button-text{color:#fff;font-size:30rpx;font-weight:700}.error{color:#fda4af;display:block;font-size:26rpx;margin-top:20rpx}.done{margin-top:44rpx}.done-icon{color:#fb7185;display:block;font-size:56rpx}.done-text{color:#f1f5f9;display:block;font-size:32rpx;font-weight:600;margin-top:16rpx}.note{color:#94a3b8;display:block;font-size:26rpx;margin-top:32rpx}