.index4{background:radial-gradient(2200rpx 1040rpx at 50% -15%,hsla(0,91%,71%,.16),transparent 62%),#0b1020;color:#e2e8f0;min-height:100vh}.hero{margin:0 auto;max-width:1720rpx;padding:112rpx 40rpx 60rpx;text-align:center}.eyebrow{color:#fb7185;display:block;font-size:24rpx;font-weight:700;letter-spacing:4rpx}.title{color:#fff;display:block;font-size:80rpx;font-weight:900;line-height:1.1;margin-top:20rpx}.subtitle{color:#cbd5e1;display:block;font-size:32rpx;line-height:1.6;margin-top:28rpx}.waitlist-box{background:rgba(15,23,42,.78);border:2rpx solid rgba(148,163,184,.25);border-radius:28rpx;margin-top:44rpx;padding:32rpx}.top-box{margin-left:auto;margin-right:auto;max-width:1360rpx}.waitlist-title{color:#f8fafc;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx;text-align:left}.input-row{display:flex;gap:20rpx}.email-input{background:#0f172a;border:2rpx solid #334155;border-radius:20rpx;box-sizing:border-box;color:#f8fafc;flex:1;height:92rpx;min-width:0;padding:0 28rpx}.submit-btn{align-items:center;background:linear-gradient(135deg,#ef4444,#fb7185);border-radius:20rpx;display:flex;flex-shrink:0;height:92rpx;justify-content:center;padding:0 36rpx}.submit-btn.disabled{opacity:.65}.submit-btn-text{color:#fff;font-size:28rpx;font-weight:700;white-space:nowrap}.content{display:grid;gap:24rpx;grid-template-columns:1fr;margin:0 auto;max-width:1720rpx;padding:20rpx 40rpx}.block-card{background:rgba(15,23,42,.74);border:2rpx solid rgba(148,163,184,.22);border-radius:28rpx;padding:36rpx}.block-kicker{color:#fb7185;display:block;font-size:24rpx;font-weight:700;letter-spacing:2.4rpx;margin-bottom:12rpx}.block-title{color:#fff;display:block;font-size:36rpx;font-weight:700}.block-desc{color:#cbd5e1;display:block;font-size:28rpx;line-height:1.72;margin-top:16rpx}.bottom-cta{margin:0 auto;max-width:1720rpx;padding:60rpx 40rpx 112rpx;text-align:center}.bottom-title{color:#fff;display:block;font-size:56rpx;font-weight:800;line-height:1.2}.bottom-sub{color:#cbd5e1;display:block;font-size:30rpx;margin-top:20rpx}.success-msg{color:#86efac;display:block;font-size:28rpx;font-weight:600;margin-top:24rpx}.error-msg{color:#fda4af;display:block;font-size:28rpx;font-weight:600;margin-top:24rpx}.foot-note{color:#64748b;display:block;font-size:24rpx;margin-top:20rpx}@media (min-width:780px){.content{grid-template-columns:1fr 1fr 1fr}.title{font-size:104rpx}.bottom-title{font-size:68rpx}}