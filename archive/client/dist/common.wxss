.index7{background:linear-gradient(180deg,#f8fbff,#edf5ff);color:#0f172a;min-height:100vh;overflow-y:auto}.hero{overflow:hidden;padding:88rpx 40rpx 56rpx;position:relative}.hero-inner,.section-inner{margin:0 auto;max-width:1960rpx;position:relative;z-index:1}@keyframes breathe{0%{opacity:.32;transform:scale(1)}50%{opacity:.55;transform:scale(1.08)}100%{opacity:.32;transform:scale(1)}}.breathe{animation:breathe 3.8s ease-in-out infinite;border-radius:1998rpx;filter:blur(4rpx);pointer-events:none;position:absolute}.breathe-one{background:rgba(59,130,246,.22);height:440rpx;right:-120rpx;top:-140rpx;width:440rpx}.breathe-two{animation-delay:1s;background:rgba(16,185,129,.18);height:360rpx;left:-100rpx;top:160rpx;width:360rpx}.hero-eyebrow{color:#2563eb;display:block;font-size:24rpx;font-weight:700;letter-spacing:3.6rpx;text-align:center}.hero-title{display:block;font-size:72rpx;font-weight:900;line-height:1.18;margin-top:20rpx;text-align:center;white-space:pre-line}.hero-desc{color:#334155;display:block;font-size:32rpx;line-height:1.72;margin:28rpx auto 0;max-width:1360rpx;text-align:center}.section{padding:68rpx 40rpx}.section-kicker{color:#2563eb;display:block;font-size:24rpx;font-weight:700;letter-spacing:2rpx}.section-title{display:block;font-size:56rpx;font-weight:800;line-height:1.25;margin-top:12rpx}.section-copy{color:#334155;display:block;font-size:30rpx;line-height:1.8;margin-top:24rpx;max-width:1520rpx}.section-why{background:#fff}.section-how{background:#f8fbff}.section-what{background:#fff}.how-grid,.what-grid{display:grid;gap:24rpx;grid-template-columns:1fr;margin-top:36rpx}.how-card,.what-card{background:hsla(0,0%,100%,.92);border:2rpx solid #dbeafe;border-radius:32rpx;box-shadow:0 20rpx 48rpx rgba(37,99,235,.05);padding:36rpx}.how-num{align-items:center;background:#2563eb;border-radius:1998rpx;color:#fff;display:inline-flex;font-size:26rpx;font-weight:800;height:56rpx;justify-content:center;margin-bottom:20rpx;width:56rpx}.how-text,.what-text{color:#334155;display:block;font-size:30rpx;line-height:1.7}.what-title{display:block;font-size:34rpx;font-weight:800;margin-bottom:16rpx}.bottom-cta{background:linear-gradient(180deg,#eff6ff,#dbeafe);padding:80rpx 40rpx 112rpx}.bottom-title{display:block;font-size:56rpx;font-weight:800;line-height:1.24;text-align:center}.bottom-sub{color:#334155;display:block;font-size:30rpx;margin-top:20rpx;text-align:center}.waitlist-box{background:hsla(0,0%,100%,.92);border:2rpx solid #bfdbfe;border-radius:32rpx;margin-top:40rpx;padding:32rpx}.top-waitlist{margin-left:auto;margin-right:auto;max-width:1400rpx}.bottom-waitlist{margin-left:auto;margin-right:auto;max-width:1520rpx}.waitlist-label{color:#0f172a;display:block;font-size:28rpx;font-weight:600;margin-bottom:20rpx}.waitlist-row{display:flex;gap:20rpx}.waitlist-input{background:#fff;border:2rpx solid #cbd5e1;border-radius:20rpx;box-sizing:border-box;color:#0f172a;flex:1;height:96rpx;min-width:0;padding:0 28rpx}.waitlist-btn{align-items:center;background:linear-gradient(135deg,#2563eb,#3b82f6);border-radius:20rpx;box-shadow:0 16rpx 40rpx rgba(37,99,235,.22);display:flex;flex-shrink:0;height:96rpx;justify-content:center;padding:0 36rpx}.waitlist-btn.disabled{opacity:.62}.waitlist-btn-text{color:#fff;font-size:28rpx;font-weight:700;white-space:nowrap}.err-msg,.foot-note,.ok-msg{display:block;text-align:center}.ok-msg{color:#059669;font-size:28rpx;font-weight:600;margin-top:24rpx}.err-msg{color:#dc2626;font-size:28rpx;font-weight:600;margin-top:24rpx}.foot-note{color:#475569;font-size:24rpx;margin-top:20rpx}@media (min-width:900px){.hero-title{font-size:100rpx}.how-grid,.what-grid{grid-template-columns:repeat(3,1fr)}.bottom-title,.section-title{font-size:68rpx}}