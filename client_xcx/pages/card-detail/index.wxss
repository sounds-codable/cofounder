.back-nav {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 141, 255, 0.3);
  color: #435bc6;
  background: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.detail-hero-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(104, 142, 186, 0.22);
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 56rpx rgba(103, 129, 171, 0.12);
}

.detail-headline {
  font-size: 40rpx;
  font-weight: 700;
  color: #10233f;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

.detail-summary {
  font-size: 28rpx;
  color: #597693;
  line-height: 1.72;
}

.detail-revealed {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(104, 142, 186, 0.22);
  border-radius: 24rpx;
  padding: 24rpx;
}

.detail-block {
  margin-bottom: 20rpx;
}

.detail-block:last-child {
  margin-bottom: 0;
}

.contact-item {
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(104, 142, 186, 0.22);
  background: rgba(255, 255, 255, 0.78);
  margin-bottom: 12rpx;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
