.brand-wrap-center {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.brand-mark-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #20d6c2 0%, #13bfa8 52%, #4cc8ff 100%);
  position: relative;
  box-shadow: 0 18rpx 38rpx rgba(76, 112, 173, 0.24);
}

.brand-core-lg {
  position: absolute;
  top: 26rpx;
  left: 22rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.94);
}

.brand-core-alt-lg {
  top: 42rpx;
  left: 48rpx;
  border-color: rgba(255, 255, 255, 0.74);
}

.brand-dot-lg {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  top: 22rpx;
  right: 22rpx;
  background: rgba(255, 255, 255, 0.92);
}

.avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #13bfa8 0%, #3bc9f5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  flex-shrink: 0;
}
