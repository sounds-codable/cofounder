page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  color: #10233f;
  background: linear-gradient(180deg, #f6fbff 0%, #eef5ff 40%, #edf4ff 100%);
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #10233f;
  margin-bottom: 24rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #597693;
  margin-bottom: 32rpx;
}

.card {
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(104, 142, 186, 0.22);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 20rpx 56rpx rgba(103, 129, 171, 0.12);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #10233f;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #597693;
  line-height: 1.72;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #597693;
  border: 1rpx solid rgba(104, 142, 186, 0.22);
  font-size: 22rpx;
}

.pill-role {
  color: #3c50a0;
  background: rgba(124, 156, 255, 0.16);
}

.tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(126, 240, 198, 0.18);
  color: #13bfa8;
  font-size: 22rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #13bfa8 0%, #3bc9f5 100%);
  color: #ffffff;
  border: none;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 12rpx 34rpx rgba(19, 191, 168, 0.22);
  text-align: center;
  line-height: 1.4;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.78);
  color: #10233f;
  border: 1rpx solid rgba(104, 142, 186, 0.38);
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.4;
}

.btn-ghost::after {
  border: none;
}

.btn-danger {
  background: rgba(255, 240, 243, 0.85);
  color: #dc4d4d;
  border: 1rpx solid rgba(213, 72, 92, 0.38);
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.4;
}

.btn-danger::after {
  border: none;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: 1rpx solid rgba(104, 142, 186, 0.38);
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #10233f;
  background: rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
}

.input-field-placeholder {
  color: #8191b4;
}

.textarea-field {
  width: 100%;
  border: 1rpx solid rgba(104, 142, 186, 0.38);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #10233f;
  background: rgba(255, 255, 255, 0.6);
  box-sizing: border-box;
  min-height: 200rpx;
}

.form-label {
  font-size: 28rpx;
  color: #10233f;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-group {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #10233f;
  margin-bottom: 20rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #597693;
  text-align: center;
}

.engagement-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.engagement-icons {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.engagement-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(104, 142, 186, 0.38);
  background: rgba(255, 255, 255, 0.78);
  font-size: 28rpx;
}

.engagement-btn.active {
  border-color: rgba(19, 191, 168, 0.42);
  color: #13bfa8;
  background: rgba(19, 191, 168, 0.08);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-success {
  color: #13bfa8;
  background: rgba(19, 191, 168, 0.1);
}

.status-pending {
  color: #597693;
  background: rgba(104, 142, 186, 0.1);
}

.status-error {
  color: #dc4d4d;
  background: rgba(220, 77, 77, 0.1);
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
}

.gap-sm {
  gap: 12rpx;
}

.gap-md {
  gap: 20rpx;
}

.mt-sm {
  margin-top: 12rpx;
}

.mt-md {
  margin-top: 24rpx;
}

.mb-sm {
  margin-bottom: 12rpx;
}

.mb-md {
  margin-bottom: 24rpx;
}

.text-muted {
  color: #597693;
}

.text-primary {
  color: #13bfa8;
}

.text-sm {
  font-size: 24rpx;
}

.text-xs {
  font-size: 22rpx;
}

.divider {
  height: 1rpx;
  background: rgba(104, 142, 186, 0.22);
  margin: 24rpx 0;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-header {
  display: flex;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(104, 142, 186, 0.22);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #597693;
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, #13bfa8 0%, #3bc9f5 100%);
  color: #ffffff;
  font-weight: 500;
}
